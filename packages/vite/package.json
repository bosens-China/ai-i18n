{
  "name": "@ai-i18n/vite",
  "version": "1.0.0-alpha.19",
  "description": "AI-powered i18n plugin for Vite with source-text extraction and browser runtime localization.",
  "keywords": [
    "ai-i18n",
    "ai",
    "i18n",
    "internationalization",
    "localization",
    "translation",
    "vite",
    "vite-plugin",
    "vue",
    "react"
  ],
  "license": "MIT",
  "author": "yliu",
  "homepage": "https://github.com/bosens-China/ai-i18n#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosens-China/ai-i18n.git",
    "directory": "packages/vite"
  },
  "bugs": {
    "url": "https://github.com/bosens-China/ai-i18n/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js"
    }
  },
  "scripts": {
    "build": "pnpm --dir ../.. exec tsdown --filter @ai-i18n/vite && node scripts/copy-review-ui.mjs",
    "lint": "eslint .",
    "check": "tsc -p tsconfig.json --noEmit && pnpm lint",
    "test": "pnpm --dir ../.. exec vitest run packages/vite/test --config vitest.config.ts"
  },
  "dependencies": {
    "@ai-i18n/analyzer": "workspace:*",
    "@ai-i18n/core": "workspace:*",
    "atomically": "2.1.1",
    "magic-string": "1.1.0",
    "parse5": "8.0.1",
    "yuku-analyzer": "0.8.4"
  },
  "peerDependencies": {
    "@vue/compiler-sfc": ">=3.2.0",
    "react": ">=18.0.0",
    "vite": ">=8.0.0",
    "vue": ">=3.2.25"
  },
  "peerDependenciesMeta": {
    "@vue/compiler-sfc": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-i18n/review-ui": "workspace:*",
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/compiler-sfc": "^3.5.34",
    "babel-plugin-react-compiler": "^1.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
