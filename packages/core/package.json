{
  "name": "@ai-i18n/core",
  "version": "1.0.0-alpha.13",
  "description": "Framework-agnostic i18n runtime, translation storage, and provider contracts for ai-i18n.",
  "keywords": [
    "ai-i18n",
    "i18n",
    "internationalization",
    "localization",
    "translation",
    "runtime"
  ],
  "license": "MIT",
  "author": "yliu",
  "homepage": "https://github.com/bosens-China/ai-i18n#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosens-China/ai-i18n.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/bosens-China/ai-i18n/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./translation-memory": {
      "types": "./dist/translation-memory.d.ts",
      "import": "./dist/translation-memory.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js"
    }
  },
  "scripts": {
    "build": "pnpm --dir ../.. exec tsdown --filter @ai-i18n/core",
    "lint": "eslint .",
    "check": "tsc -p tsconfig.json --noEmit && pnpm lint",
    "test": "pnpm --dir ../.. exec vitest run packages/core/test --config vitest.config.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "atomically": "2.1.1",
    "fs-native-extensions": "1.5.0"
  }
}
