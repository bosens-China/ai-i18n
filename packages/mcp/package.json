{
  "name": "@ai-i18n/mcp",
  "version": "1.0.0-alpha.19",
  "description": "MCP server for inspecting, translating, and reviewing ai-i18n messages.",
  "keywords": [
    "ai-i18n",
    "ai",
    "i18n",
    "internationalization",
    "localization",
    "mcp",
    "model-context-protocol",
    "translation"
  ],
  "license": "MIT",
  "author": "yliu",
  "homepage": "https://github.com/bosens-China/ai-i18n#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosens-China/ai-i18n.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/bosens-China/ai-i18n/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ai-i18n-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --dir ../.. exec tsdown --filter @ai-i18n/mcp",
    "lint": "eslint .",
    "check": "tsc -p tsconfig.json --noEmit && pnpm lint",
    "test": "pnpm --dir ../.. exec vitest run packages/mcp/test --config vitest.config.ts"
  },
  "dependencies": {
    "@ai-i18n/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
