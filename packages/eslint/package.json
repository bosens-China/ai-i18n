{
  "name": "@ai-i18n/eslint-plugin",
  "version": "1.0.0-alpha.22",
  "description": "ESLint rules for ai-i18n static extraction and reactive runtime usage.",
  "keywords": [
    "ai-i18n",
    "eslint",
    "eslint-plugin",
    "i18n",
    "internationalization",
    "localization",
    "static-analysis",
    "translation"
  ],
  "license": "MIT",
  "author": "yliu",
  "homepage": "https://github.com/bosens-China/ai-i18n#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosens-China/ai-i18n.git",
    "directory": "packages/eslint"
  },
  "bugs": {
    "url": "https://github.com/bosens-China/ai-i18n/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --dir ../.. exec tsdown --filter @ai-i18n/eslint-plugin",
    "lint": "eslint .",
    "check": "tsc -p tsconfig.json --noEmit && pnpm lint",
    "test": "pnpm --dir ../.. exec vitest run packages/eslint/src --config vitest.config.ts"
  },
  "dependencies": {
    "@ai-i18n/analyzer": "workspace:*",
    "get-tsconfig": "^4.14.1",
    "parse5": "8.0.1",
    "picomatch": "^4.0.5"
  },
  "peerDependencies": {
    "@vue/compiler-sfc": ">=3.2.0",
    "eslint": ">=9.0.0",
    "typescript": ">=5.0.0",
    "vue": ">=3.2.25",
    "vue-eslint-parser": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "@vue/compiler-sfc": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vue-eslint-parser": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3",
    "@vue/compiler-sfc": "^3.5.34",
    "vue-eslint-parser": "^10.4.1"
  }
}
