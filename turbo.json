{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "eslint.config.js",
    "pnpm-lock.yaml",
    "tsconfig.base.json",
    "tsdown.config.ts",
    "vitest.config.ts"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "src/**",
        "server/**",
        "scripts/**",
        "remote.ts",
        "style.css",
        "i18n/**",
        "i18n-overlay/**",
        "index.html",
        "vite.config.ts",
        "tsconfig*.json",
        "package.json"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    },
    "check": {
      "dependsOn": ["build", "^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["build", "^build"]
    }
  }
}
